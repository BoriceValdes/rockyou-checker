{
  "rules": [
    { "code": "min_length", "label": "Au moins 12 caractères", "type": "min_length", "value": 12 },
    { "code": "lowercase", "label": "Contient une minuscule", "type": "has_lower" },
    { "code": "uppercase", "label": "Contient une majuscule", "type": "has_upper" },
    { "code": "digit", "label": "Contient un chiffre", "type": "has_digit" },
    {
      "code": "special",
      "label": "Contient un caractère spécial",
      "type": "has_any_char",
      "chars": "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
    },
    {
      "code": "no_sequence",
      "label": "Pas de suite évidente (azerty, 1234...)",
      "type": "no_sequence",
      "patterns": ["0123456789", "abcdefghijklmnopqrstuvwxyz", "azertyuiop", "qwertyuiop"],
      "window": 4
    },
    {
      "code": "no_repeat",
      "label": "Pas de caractère répété 4 fois ou plus",
      "type": "no_repeated_char",
      "max_run": 3
    }
  ],
  "severity_thresholds": { "ok_score": 100, "weak_min_score": 60 }
}
