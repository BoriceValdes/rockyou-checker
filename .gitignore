__pycache__/
**/__pycache__/
*.pyc
backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/*.egg-info/
backend/.coverage
backend/htmlcov/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Go
importer/importer
importer/*.exe

# Environnement
.env
*.env.local

